      <column caption='Total Transaction Volume' datatype='real' name='[Calculation_0404651572604929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spend]) / 10000000' />
      </column>
      <column caption='Average Monthly Spend' datatype='real' name='[Calculation_0404651575668738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(total_spend)' />
